# Copy this file to .streamlit/secrets.toml (local) or paste its contents into
# your app's "Secrets" settings on Streamlit Community Cloud. Never commit the
# real, filled-in version of this file to a public GitHub repo.

[auth]
# Local development — leave exactly as-is:
redirect_uri = "http://localhost:8501/oauth2callback"
# Once deployed, ADD a second redirect URI in Google Cloud for your real URL, e.g.:
# https://your-app-name.streamlit.app/oauth2callback
# and update this line to match whichever environment is running.

cookie_secret = "REPLACE_WITH_ANY_LONG_RANDOM_STRING"
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri = "https://YOUR-APP-NAME.streamlit.app/oauth2callback"
cookie_secret = "some-long-random-string-you-made-up"

[auth.google]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
